rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 인증된 사용자만 접근 가능
    match /audio/{userId}/{audioId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 템플릿 파일은 인증된 사용자만 접근
    match /templates/{userId}/{templateId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 사용자 프로필 이미지 (향후 사용)
    match /profiles/{userId}/{imageId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 기본적으로 모든 다른 경로는 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
